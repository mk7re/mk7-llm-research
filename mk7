#!/usr/bin/env python3
"""Launcher for the mk7 research CLI (mk7-llm-research/tools/mk7re). Run from anywhere."""
import os
import sys
from pathlib import Path

WORKSPACE = Path(__file__).resolve().parent

# The few pip packages the CLI needs (requirements.txt) live in local/venv; use it when it exists.
venv = WORKSPACE / "local" / "venv"
venv_python = venv / "bin" / "python"
if venv_python.exists() and Path(sys.prefix).resolve() != venv.resolve():
    os.execv(venv_python, [str(venv_python), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.dont_write_bytecode = True
sys.path.insert(0, str(WORKSPACE / "tools"))

from mk7re.cli import main

sys.exit(main())
