 #include "VehicleControl.hpp"
 
+
+#include <math/seadQuat.h>
+
 BEGIN_NAMESPACE(Kart)
 {
 	/START_CLASS/NAME@VehicleControlNet/SIZE@0xBE8/BASE@VehicleControl/BSIZE@0x11C/
 	public:
+		// Events of a kart that the remote consoles replay. A console that drives the kart sets the bits in
+		// m_net_event_send_bits; each one toggles a bit of NetData::m_kart_data, and the receiving consoles set the
+		// same bit in m_net_event_recv_bits and clear it once the event is replayed
+		enum ENetEvent : u32 {
+			DRIFT_JUMP = 0x1,
+			WARP = 0x2,             // the receivers move the kart to the received position at once
+			HIT_KART_0 = 0x4,       // hit the kart of player id 0; HIT_KART_0 << n for player id n (0 to 7)
+			JUMP_ACTION = 0x400,
+			TWIST = 0x800,
+			THROW_FORWARD = 0x1000,
+			THROW_BACKWARD = 0x2000,
+			DASH_RESTART = 0x4000,
+		};
+
 		/START_STRUCT/NAME@NetTrackData/SIZE@0x20/
 			/M/sead::Vector3f position/0xC/0x0/
-			/U/sead::Vector3f/0xC/0xC/ // Vehicle::0xF44
+			/M/sead::Vector3f forward_dir/0xC/0xC/
 			/U/f32/0x4/0x18/ // slip
 			/M/u32 frame/0x4/0x1C/
 		/END/
+
+		// Ring buffer of NetTrackData
+		/START_STRUCT/NAME@NetTrackRing/SIZE@0x10/
+			/M/NetTrackData *m_entries/0x4/0x0/
+			/M/s32 m_capacity/0x4/0x4/
+			/M/s32 m_head/0x4/0x8/
+			/M/s32 m_count/0x4/0xC/
+		/END/
+
+		/M/u8 m_net_send_data[0x48]/0x48/0x11C/ // NetData: what the console that drives the kart sends
+		/M/u8 m_net_recv_datas[2][0x48]/0x90/0x164/ // two NetData, used by m_net_recv_data and m_net_recv_data_prev
+		/M/NetData *m_net_recv_data/0x4/0x1F4/ // the newest NetData received for this kart
+		/M/NetData *m_net_recv_data_prev/0x4/0x1F8/ // the NetData received before it
+		/M/s32 m_net_recv_frame/0x4/0x1FC/ // own frame when the newest NetData arrived; -1: none yet
+		/M/f32 m_net_delay/0x4/0x200/ // frames between the sender's frame of the newest NetData and the own frame, smoothed
+		/M/f32 m_net_delay_weight/0x4/0x204/ // 1 when a NetData arrives, then decays every frame
+		/M/f32 m_net_track_delay/0x4/0x208/ // delay used to pick the received position the kart is steered to
+		/M/NetTrackRing m_own_track/0x10/0x20C/ // the last 60 positions of the kart on this console
+		/M/NetTrackData m_own_track_storage[60]/0x780/0x21C/
+		/M/NetTrackRing m_recv_track/0x10/0x99C/ // the last 16 received positions
+		/M/NetTrackData m_recv_track_storage[16]/0x200/0x9AC/
+		/M/sead::Vector3f m_net_correction/0xC/0xBAC/ // position correction applied to a received kart
+		/M/sead::Vector3f m_net_track_offset/0xC/0xBB8/ // newest usable received position minus the own position of the same frame
+		/M/sead::Quatf m_net_track_rotation/0x10/0xBC4/ // rotation from the own forward direction to the received one
+		/M/u32 m_net_track_frame/0x4/0xBD4/ // sender's frame of that received position
+		/M/u32 m_net_warp_frame/0x4/0xBD8/ // frame of the last warp to the received position
+		/M/u32 m_net_event_send_bits/0x4/0xBDC/ // ENetEvent
+		/M/u32 m_net_event_recv_bits/0x4/0xBE0/ // ENetEvent
+		/M/Net::NetworkEngine *m_network_engine/0x4/0xBE4/
 	/END/
-}
