+
+BEGIN_NAMESPACE(Net)
+{
+    // What each console sends in the GameData buffer: the goals and scores it knows of, and how far the consoles
+    // agree on them. The bitmaps are by aid
+    /START_STRUCT/NAME@NetworkGameDataFormat/SIZE@0x30/
+        /M/u8 m_goal_aid_bits/0x1/0x0/ // karts whose goal the sender knows, with their m_scores
+        /M/u8 m_goal_confirmed_aid_bits/0x1/0x1/ // goals the sender knows every connected console has
+        /M/u8 m_disconnected_aid_bits/0x1/0x2/ // consoles the sender has seen leave
+        /M/u8 m_disconnect_confirmed_aid_bits/0x1/0x3/ // departures every connected console has seen
+        /U/u8/0x1/0x4/
+        /M/u8 m_takeover_goal_aid_bits/0x1/0x5/ // goals of karts the sender took over
+        // By aid of the console that took a kart over: the karts whose goal, sent by that console, the sender
+        // accepted
+        /M/u8 m_accepted_takeover_goal_aid_bits[KART_MAX]/0x8/0x6/
+        /M/s32 m_scores[KART_MAX]/0x20/0x10/ // finish time or points; -1: none
+    /END/
+
+    /START_CLASS/NAME@NetworkGameDataManager/SIZE@0x90/BASE@NetworkDataManager<NetworkGameDataFormat>/BSIZE@0x7D/
+    public:
+        /M/sead::Buffer<NetworkGameDataFormat> m_received/0x8/0x80/ // by aid: the last packet accepted
+        /M/bool m_is_before_start/0x1/0x88/ // the race has not started: packets are stored without checks
+        /M/bool m_is_rank_fixed/0x1/0x89/ // every rank is fixed: packets are no longer stored
+        /U/bool/0x1/0x8A/
+        /M/NetworkGameMgr *m_network_game_mgr/0x4/0x8C/
+    /END/
+
+    // Ranks, goals and scores of a race or battle, agreed between the consoles
+    /START_CLASS/NAME@NetworkGameMgr/SIZE@0xC4/BASE@Object::Actor/BSIZE@0x8/
+    public:
+        // Deterministic choice of the console that drives the karts nobody drives: the CPUs and, online, the
+        // karts of the consoles that left
+        /START_STRUCT/NAME@TakeoverMigration/SIZE@0x5C/
+            /M/NetworkGameDataManager *m_data_manager/0x4/0x0/
+            /M/s32 m_owner_player_ids[KART_MAX]/0x20/0x4/ // by aid: player id of the console that drives the kart; -1: none
+            /M/sead::IDelegate2<s32, s32> *m_handler/0x4/0x44/ // called with the kart's aid and the new owner
+            /M/u8 m_lost_aid_bits/0x1/0x48/ // karts that need a new owner: disconnected or empty slots
+            /M/u8 m_lost_aid_bits_prev/0x1/0x49/
+            /M/u8 m_absent_aid_bits/0x1/0x4B/ // slots without a human racer: the CPUs
+            /M/u8 m_taken_over_by_me_aid_bits/0x1/0x4C/
+            /M/u8 m_handled_aid_bits/0x1/0x4E/ // karts whose new owner has been chosen
+            /M/bool m_is_enabled/0x1/0x4F/
+            /M/bool m_take_over_humans/0x1/0x50/ // karts of consoles that left get an owner too (online)
+            /M/u8 m_takeover_goal_aid_bits/0x1/0x58/ // karts whose goal the owner has set
+        /END/
+
+        /START_CLASS/NAME@Rank/SIZE@0xC8/
+        public:
+            enum class Type : s32 {
+                TIME = 1,   // lowest score first
+                SCORE = 2,  // highest score first
+            };
+
+            /M/NetworkGameDataManager *m_data_manager/0x4/0x0/
+            /M/TakeoverMigration *m_takeover_migration/0x4/0x4/
+            /M/void *m_policy/0x4/0x8/ // the PolicyTime or PolicyScore below
+            /M/void *m_policy_time/0x4/0xC/ // vtable of Rank::PolicyTime
+            /M/void *m_policy_score/0x4/0x10/ // vtable of Rank::PolicyScore
+            /M/s32 m_my_score/0x4/0x18/ // -1: none
+            /M/bool m_is_my_goal/0x1/0x1C/
+            /M/bool m_is_finished/0x1/0x1F/ // every rank is fixed
+            /M/u8 m_goal_confirmed_aid_bits/0x1/0x20/ // AND of the consoles' NetworkGameDataFormat::m_goal_confirmed_aid_bits
+            /M/u8 m_disconnect_confirmed_aid_bits/0x1/0x21/ // AND of the consoles' NetworkGameDataFormat::m_disconnect_confirmed_aid_bits
+            /M/u8 m_auto_rank_aid_bits/0x1/0x22/ // karts given the one rank left over
+            /U/u8/0x1/0x23/
+            /M/u8 m_disconnected_aid_bits/0x1/0x24/
+            /M/s32 m_ranks[KART_MAX]/0x20/0x28/ // by aid: fixed rank; -1: none
+            /M/s32 m_auto_ranks[KART_MAX]/0x20/0x48/ // by aid: rank left over, given without a goal; -1: none
+            /M/s32 m_aids_by_rank[KART_MAX]/0x20/0x68/
+            /M/s32 m_aids_by_auto_rank[KART_MAX]/0x20/0x88/
+            /M/s32 m_scores[KART_MAX]/0x20/0xA8/ // by aid
+        /END/
+
+        /M/NetworkGameDataManager m_data_manager/0x90/0x8/
+        /M/Rank *m_rank/0x4/0x98/
+        /M/bool m_is_race_active/0x1/0x9C/ // a race is running
+        /M/bool m_is_alone/0x1/0x9D/ // no other console is left
+                /M/u32 m_goal_frame_counter/0x4/0xC0/ // counts frames from the local goal on
+    /END/
+}
