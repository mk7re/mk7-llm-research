+#pragma once
+
+#include "../types.hpp"
+#include "../forward.hpp"
+#include "../Util/TStateObserver.hpp"
+
+#include <container/seadBuffer.h>
+
+BEGIN_NAMESPACE(Net)
+{
+    // A state number that the connected racers change together: a console asks for the next state and every
+    // console switches once all of them are ready
+    /START_CLASS/NAME@NetworkStateCalc/SIZE@0x2C/VTABLE@True/
+    public:
+        virtual void onChangeState() {} // 0: the state has just switched
+        virtual void onDisconnect() {} // 1: the set of connected racers has changed
+
+        /M/bool m_is_active/0x1/0x4/
+        /M/u8 m_ready_aid_bits/0x1/0x5/ // aids ready to leave the current state
+        /M/sead::Buffer<u8> m_states/0x8/0x8/ // by aid: the last state that console sent
+        /M/s32 m_requested_state/0x4/0x10/ // -1: none
+        /M/u8 m_waiting_state/0x1/0x14/ // state sent while the local console is not a racer
+        /M/bool m_waiting_ready/0x1/0x15/ // ready bit sent while the local console is not a racer
+        /M/bool m_state_changed/0x1/0x16/ // the state changed this frame
+        /M/NetworkEngine *m_network_engine/0x4/0x18/
+        /M/u8 m_connected_racer_aid_bits/0x1/0x28/ // NetworkStationBufferManager::m_registered_aid_bits last frame
+    /END/
+
+    template <class T>
+    class NetworkStateManager : public NetworkStateCalc
+    {
+    public:
+        Util::TStateObserver<T> m_state_observer;
+    };
+    static_assert(sizeof(NetworkStateManager<void>) == 0x4C);
+}
