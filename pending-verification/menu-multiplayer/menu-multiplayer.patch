diff -ruN a/template/Net/NetworkSupplyInfoManager.hpp b/template/Net/NetworkSupplyInfoManager.hpp
--- a/template/Net/NetworkSupplyInfoManager.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/template/Net/NetworkSupplyInfoManager.hpp	2026-11-14 23:17:31.676146045 +0100
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "../types.hpp"
+#include "../common.hpp"
+#include "../System/PlayerData.hpp"
+#include "NetworkDataManager.hpp"
+#include "NetworkSelectMenuSendFormat.hpp"
+
+#include <container/seadPtrArray.h>
+
+BEGIN_NAMESPACE(Net)
+{
+    // One player's choices packed into 39 bits, in this order: driver (5 bits), body (5), tire (4), wing (3), race
+    // point (9), race rank minus one (3), course (6), mode (3), team (1)
+    /START_STRUCT/NAME@RaceSetting/SIZE@0x8/
+        /M/u8 m_bits[8]/0x8/0x0/
+    /END/
+
+    /START_STRUCT/NAME@PlayerInfo/SIZE@0xC/
+        /M/u32 m_principal_id/0x4/0x0/ // 0: empty entry
+        /M/RaceSetting m_race_setting/0x8/0x4/
+    /END/
+
+    // What each console sends every frame in the NetworkSupplyInfo buffer: the choices it knows of every player
+    /START_STRUCT/NAME@NetworkSupplyInfoSendFormat/SIZE@0x60/
+        /M/PlayerInfo m_player_infos[KART_MAX]/0x60/0x0/ // by player id
+    /END/
+
+    // Keeps the choices and profiles of every player, also of those whose own packets were missed or who left, by
+    // merging what every console reports
