diff -ruN a/template/Net/WbtProtocol.hpp b/template/Net/WbtProtocol.hpp
--- a/template/Net/WbtProtocol.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/template/Net/WbtProtocol.hpp	2026-11-14 23:18:16.353619419 +0100
@@ -0,0 +1,60 @@
+#pragma once
+
+#include "../types.hpp"
+
+BEGIN_NAMESPACE(Net)
+{
+    // Block transfer protocol: the parent sends registered data blocks in chunks, the children ask for the chunks
+    // they missed
+    /START_CLASS/NAME@WbtProtocol/SIZE@0x584C/
+    public:
+        enum class EPacketKind : u8 {
+            DATA = 0,       // parent: a chunk of data; child: a report or a request
+            END_OF_PASS = 1,
+        };
+
+        // Starts every packet. The payload of a data chunk follows it
+        /START_STRUCT/NAME@PacketHeader/SIZE@0x8/
+            /M/u8 m_block_id/0x1/0x0/ // child: 0xFF once it has received every block
+            /M/EPacketKind m_kind/0x1/0x1/
+            /M/u16 m_chunk_index/0x2/0x2/ // 0xFFFF in an end-of-pass packet
+            /M/u32 m_value/0x4/0x4/ // parent: size of the block; child: number of chunks it has received
+        /END/
+
+        /START_STRUCT/NAME@Block/SIZE@0xC/
+            /M/u8 m_id/0x1/0x0/
+            /M/u8 *m_data/0x4/0x4/
+            /M/u32 m_size/0x4/0x8/
+        /END/
+
+        /M/bool m_is_parent/0x1/0x0/
+        /M/bool m_is_running/0x1/0x1/
+        /M/bool m_is_finished/0x1/0x2/
+        /M/bool m_is_dummy_child/0x1/0x3/ // takes part without receiving the data
+        /M/s32 m_player_id/0x4/0x4/
+        /M/s32 m_chunk_size/0x4/0x8/ // payload bytes per packet
+        /M/s32 m_max_size/0x4/0xC/ // packet size times 400
+        /M/s32 m_block_num/0x4/0x10/
+        /M/Block m_blocks[16]/0xC0/0x14/
+        /M/s32 m_current_block_id/0x4/0xD4/ // -1: none
+        // Parent: next chunk of the first pass, -1 once it is over. Child: highest chunk index received
+        /M/s32 m_chunk_cursor/0x4/0xD8/
+        /M/s32 m_child_block_index/0x4/0xDC/ // child: index in m_blocks of the block being received
+        /M/s32 m_child_chunk_num/0x4/0xE0/
+        /M/s32 m_child_received_num/0x4/0xE4/
+        /M/s32 m_child_chunk_size/0x4/0xE8/
+        /M/u32 m_child_received_bits[400]/0x640/0xEC/ // child: one bit per chunk of the block
+        /M/s32 m_child_request_cursor/0x4/0x72C/ // child: where the search for a missing chunk resumes
+        /M/u32 m_child_aid_bits/0x4/0x730/
+        /M/u32 m_wait_aid_bits/0x4/0x734/ // parent: aids it must hear from before it sends
+        /M/s32 m_child_block_ids[32]/0x80/0x738/ // parent, by aid: the block each child reported last; -1: none
+        /M/s32 m_parent_chunk_num/0x4/0x7B8/
+        // Parent: queue of the chunks the children asked for again (ring buffer over m_request_storage)
+        /M/u16 *m_request_buffer/0x4/0x7BC/
+        /M/s32 m_request_capacity/0x4/0x7C0/
+        /M/s32 m_request_head/0x4/0x7C4/
+        /M/s32 m_request_num/0x4/0x7C8/
+        /M/u16 m_request_storage[0x2800]/0x5000/0x7CC/
+        /M/u32 m_child_received_nums[32]/0x80/0x57CC/ // parent, by aid: chunks received that each child reported
+    /END/
+}
